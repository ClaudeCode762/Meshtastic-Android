<resources>

    <!-- A watch face is black; a white splash flashes the whole screen on the wrist. -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Meshtastic.Main</item>
    </style>

    <!--
        Wear OS dismisses the whole activity on a swipe from the left edge. The app has its own back stack, so the
        gesture is handled in Compose as back instead (WearShell).
    -->
    <style name="Theme.Meshtastic.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

</resources>
